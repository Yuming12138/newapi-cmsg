[Unit]
Description=CMSG Home reverse-tunnel end-to-end watchdog
After=network-online.target docker.service cmsg-home-bridge.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cmsg-home-tunnel-watchdog
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run
