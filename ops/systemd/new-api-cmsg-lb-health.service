[Unit]
Description=CMSG observation-only LB health signal
After=network-online.target new-api-cmsg-network-probe.timer
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/new-api/ops/cmsg_lb_health.py serve /opt/new-api/ops/cmsg_lb_health.json
Restart=always
RestartSec=5
StateDirectory=cmsg-lb-health
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
CPUQuota=10%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
